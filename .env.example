# Kimi API Proxy Configuration

# ========== REQUIRED ==========
# Your official Kimi API Key (get from https://kimi.moonshot.cn)
KIMI_API_KEY=your_official_kimi_api_key_here

# Kimi API Base URL
KIMI_BASE_URL=https://api.kimi.moonshot.cn

# ========== SERVER ==========
PORT=3000
NODE_ENV=production

# ========== SECURITY (Auto-generated if not set) ==========
# JWT Secret for Access Tokens (min 32 chars, auto-generated if empty)
JWT_SECRET=

# JWT Secret for Refresh Tokens (min 32 chars, auto-generated if empty)
JWT_REFRESH_SECRET=

# ========== TOKENS ==========
# Access Token Expiry Time
ACCESS_TOKEN_EXPIRY=15m

# Refresh Token Expiry Time
REFRESH_TOKEN_EXPIRY=7d

# ========== RATE LIMITING ==========
# Rate limit window in minutes
RATE_LIMIT_WINDOW=15

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ========== CORS ==========
# Allowed origins (comma separated)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ========== LOGGING ==========
LOG_LEVEL=info
